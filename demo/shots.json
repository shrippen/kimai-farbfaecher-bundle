{
  "kind": "web",
  "group": "kimai",
  "start": "{repo}/demo/kimai/reset.sh --lang {lang} --theme {theme} --port {port}",
  "detach": true,
  "stop": "{repo}/demo/kimai/reset.sh --down",
  "ready": "http://127.0.0.1:{port}/en/login",
  "base": "http://127.0.0.1:{port}",
  "today": "real",
  "timeout": 600,
  "themes": [
    "default",
    "knust"
  ],
  "viewport": [
    1440,
    900
  ],
  "user": "mara",
  "setup": [
    {
      "goto": "/{lang}/login"
    },
    {
      "fill": "#username",
      "value": "{user}"
    },
    {
      "fill": "#password",
      "value": "{password}"
    },
    {
      "click": "form button[type=submit]"
    },
    {
      "wait": "body.page-header-fixed, .page-wrapper"
    }
  ],
  "shots": [
    {
      "name": "clashes",
      "url": "/{lang}/admin/farbfaecher"
    },
    {
      "name": "plan",
      "url": "/{lang}/admin/farbfaecher/plan?scope=clashes&strategy=hierarchical"
    }
  ]
}
